FROM python:3.12-slim
WORKDIR /workspace
COPY requirements/jupyter.txt /tmp/jupyter.txt
RUN pip install --no-cache-dir -r /tmp/jupyter.txt
EXPOSE 8888
CMD ["sh", "-c", "jupyter lab --allow-root --ip=0.0.0.0 --port=8888 --no-browser --ServerApp.root_dir=/workspace --ServerApp.token=\"$JUPYTER_TOKEN\""]
