# Metadata de MLflow (Postgres)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_password
POSTGRES_DB=mlflow
PGPORT=5432

# Artefactos de MLflow (MinIO, compatible con S3). MinIO exige una contraseña de al menos 8 caracteres.
AWS_ACCESS_KEY_ID=s3admin
AWS_SECRET_ACCESS_KEY=s3admin123
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=mlflow-artifacts
MLFLOW_S3_ENDPOINT_URL=http://storage:9000

# Servidor de MLflow
MLFLOW_VERSION=v2.19.0
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow_password@mlflow-db:5432/mlflow
MLFLOW_ARTIFACTS_DESTINATION=s3://mlflow-artifacts

# Base de datos de datos (MySQL), separada de la metadata de MLflow
DATA_DB_NAME=penguins
DATA_DB_USER=penguins_user
DATA_DB_PASSWORD=penguins_password
DATA_DB_ROOT_PASSWORD=root_password
DATA_DB_URL=mysql+pymysql://penguins_user:penguins_password@data-db:3306/penguins

# API de inferencia
MODEL_NAME=penguins-classifier
MODEL_ALIAS=production

# JupyterLab
JUPYTER_TOKEN=mlflow
